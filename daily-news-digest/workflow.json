        "id": "node-merge",
        "name": "Wait for All Feeds",
        "type": "n8n-nodes-base.merge",
        "typeVersion": 3,
        "position": [
          912,
          432
        ]
      },
      {
        "parameters": {
          "jsCode": "const automationItems = $('RSS: Automation & n8n').all().map(i => ({ ...i.json, topic: '\ud83d\udd27 Automation & n8n' }));\nconst aiItems = $('RSS: AI Landscape').all().map(i => ({ ...i.json, topic: '\ud83e\udd16 AI Landscape' }));\nconst financeItems = $('RSS: Finance & Investing').all().map(i => ({ ...i.json, topic: '\ud83d\udcb0 Finance & Investing' }));\nconst worldItems = $('RSS: World Breaking News').all().map(i => ({ ...i.json, topic: '\ud83c\udf0d World' }));\n\nconst seenRows = $('Read Seen Articles').all();\nconst seenUrls = new Set(seenRows.map(r => r.json.url).filter(Boolean));\n\nfunction pickFresh(items, max) {\n  return items.filter(i => i.link && !seenUrls.has(i.link)).slice(0, max);\n}\n\nconst fresh = [\n  ...pickFresh(automationItems, 3),\n  ...pickFresh(aiItems, 4),\n  ...pickFresh(financeItems, 2),\n  ...pickFresh(worldItems, 3),\n];\n\nconst chatId = $('Set Chat ID (scheduled)').all()[0]?.json?.chatId || $('Set Chat ID (manual)').all()[0]?.json?.chatId || '1984567776';\n\nif (fresh.length === 0) {\n  return [{ json: { message: '\u2705 No new news since last check.', newUrls: [], chatId } }];\n}\n\nconst grouped = {};\nfor (const item of fresh) {\n  if (!grouped[item.topic]) grouped[item.topic] = [];\n  grouped[item.topic].push(item);\n}\n\nconst now = new Date().toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });\nlet msg = `\ud83d\udcf0 *Your News Digest \u2014 ${now}*\\n`;\n\nfor (const [topic, items] of Object.entries(grouped)) {\n  msg += `\\n${topic}\\n`;\n  for (const item of items) {\n    const title = (item.title || '').replace(/[*_`\\[\\]]/g, ' ').trim();\n    const source = (item.creator || item['dc:creator'] || '').trim();\n    msg += `\u2022 [${title}](${item.link})${source ? ' \u2014 ' + source : ''}\\n`;\n  }\n}\n\nconst newUrls = fresh.map(i => ({ url: i.link, title: (i.title || '').substring(0, 200), date: new Date().toISOString().split('T')[0] }));\n\nreturn [{ json: { message: msg, newUrls, chatId } }];"
        },
