    {
      "parameters": {
        "jsCode": "// Collect all items from Edit Fields and chunk into batches of 100\nconst allItems = $input.all();\nconst newSeq = allItems[0].json.seq;\nconst batchSize = 100;\nconst batches = [];\n\nfor (let i = 0; i < allItems.length; i += batchSize) {\n  const chunk = allItems.slice(i, i + batchSize);\n  const inputs = chunk.map(item => ({\n    id: String(item.json.dealId),\n    properties: { seq: newSeq }\n  }));\n  batches.push({ json: { inputs } });\n}\n\nreturn batches;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
