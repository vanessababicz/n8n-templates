      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:5678/healthz",
        "options": {}
      },
      "id": "2",
      "name": "Get Container Uptime",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst now = new Date();\n\n// Get current version and uptime from n8n\nlet versionCli, uptimeSeconds;\ntry {\n  const settings = await $http.request({\n    method: 'GET',\n    url: 'http://localhost:5678/rest/settings',\n    headers: { 'Accept': 'application/json' }\n  });\n  versionCli = settings.data?.versionCli || 'unknown';\n} catch(e) {\n  versionCli = 'unknown';\n}\n\ntry {\n  const health = await $http.request({\n    method: 'GET',\n    url: 'http://localhost:5678/healthz',\n    headers: { 'Accept': 'application/json' }\n  });\n  // healthz returns { status: 'ok' } \u2014 not useful for uptime\n  // So we'll rely on version tracking only\n} catch(e) {}\n\n// First run \u2014 store baseline, don't notify\nif (!staticData.lastVersion) {\n  staticData.lastVersion = versionCli;\n  staticData.lastCheckTime = now.toISOString();\n  return [{ json: { updated: false, reason: 'First run \u2014 baseline stored', version: versionCli } }];\n}\n\n// Version changed = n8n was updated\nif (versionCli !== 'unknown' && versionCli !== staticData.lastVersion) {\n  const prevVersion = staticData.lastVersion;\n  staticData.lastVersion = versionCli;\n  staticData.lastCheckTime = now.toISOString();\n  return [{ json: { updated: true, previousVersion: prevVersion, currentVersion: versionCli, detectedAt: now.toISOString() } }];\n}\n\n// No change\nstaticData.lastCheckTime = now.toISOString();\nreturn [{ json: { updated: false, reason: 'No version change', version: versionCli } }];\n"
      },
      "id": "3",
      "name": "Check Docker Uptime",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
