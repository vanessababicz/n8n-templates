      "id": "validate-token",
      "name": "Validate Token"
    },
    {
      "parameters": {
        "transcriptId": "={{ $json.body.meetingId }}"
      },
      "type": "@firefliesai/n8n-nodes-fireflies.fireflies",
      "typeVersion": 1,
      "position": [
        448,
        128
      ],
      "id": "1594dd42-5f70-4bb2-b173-28a62bba2edf",
      "name": "Get Transcript",
      "credentials": {
        "firefliesApi": {
          "id": "Mqtugf2kOvBlF7W4",
          "name": "Fireflies account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const transcript = $json.data || $json;\n\n// Build filename: YYYY-MM-DD_title.md\nconst date = transcript.date \n  ? new Date(transcript.date).toISOString().split('T')[0]\n  : new Date().toISOString().split('T')[0];\n\nconst rawTitle = transcript.title || 'untitled';\nconst slug = rawTitle\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-|-$/g, '')\n  .substring(0, 60);\n\nconst filename = `${date}_${slug}.md`;\n\n// Build transcript content\nconst sentences = (transcript.sentences || []).map(s => {\n  const speaker = s.speaker_name || s.speaker || 'Unknown';\n  const text = s.text || s.raw_text || '';\n  return `**${speaker}:** ${text}`;\n}).join('\\n\\n');\n\nconst content = `# ${transcript.title || 'Untitled Meeting'}\\n\\n**Date:** ${date}  \\n**Duration:** ${transcript.duration ? Math.round(transcript.duration / 60) + ' min' : 'N/A'}  \\n**Organizer:** ${transcript.organizer_email || 'N/A'}  \\n**Participants:** ${(transcript.participants || []).join(', ') || 'N/A'}\\n\\n---\\n\\n## Transcript\\n\\n${sentences || '_No transcript text available._'}\\n`;\n\nreturn [{ json: { filename, content, path: `clients/yourcompany/sales-calls/${filename}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        128
      ],
      "id": "build-file",
      "name": "Build File"
    },
    {
      "parameters": {
        "jsCode": "const { filename, content, path } = $json;\nconst encoded = Buffer.from(content).toString('base64');\nreturn [{ json: { filename, content, path, contentBase64: encoded } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        128
      ],
      "id": "encode-content",
      "name": "Base64 Encode"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/[github-user]/[repo]/contents/{{ $json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "[your-auth-header]"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1168,
        128
      ],
      "id": "get-existing-file",
      "name": "Get Existing SHA"
    },
    {
      "parameters": {
        "jsCode": "const fileData = $json;\nconst prev = $('Base64 Encode').first().json;\n\nconst body = {\n  message: `transcript: ${prev.filename}`,\n  content: prev.contentBase64,\n  branch: 'main'\n};\n\nif (fileData.sha) {\n  body.sha = fileData.sha;\n}\n\nconst slackBody = JSON.stringify({\n  channel: '[slack-channel-id]',\n  text: `:white_check_mark: *New sales call transcript saved*\\n\\n*File:* \\`${prev.filename}\\`\\n*Path:* \\`clients/yourcompany/sales-calls/${prev.filename}\\``\n});\n\nreturn [{ json: { path: prev.path, body: JSON.stringify(body), filename: prev.filename, slackBody } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        128
      ],
      "id": "build-commit-body",
      "name": "Build Commit Body"
    },
    {
