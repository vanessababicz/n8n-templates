    {
      "parameters": {
        "jsCode": "// Get contact data from input\nconst contacts = $input.all();\n\n// Initialize result object\nconst result = {\n  contactToName: '',\n  contactToEmail: '',\n  contactCc: []\n};\n\n// Check if we have any contacts\nif (contacts.length > 0) {\n  // First contact becomes \"To\"\n  const firstContact = contacts[0].json;\n  \n  // Get first name only\n  const firstName = firstContact.properties.firstname?.value || '';\n  \n  result.contactToName = firstName;\n  \n  // If no first name available, use email as name\n  if (!result.contactToName) {\n    result.contactToName = firstContact.properties.email?.value || '';\n  }\n  \n  result.contactToEmail = firstContact.properties.email?.value || '';\n  \n  // Rest of contacts become CC (email only)\n  for (let i = 1; i < contacts.length; i++) {\n    const email = contacts[i].json.properties.email?.value;\n    if (email) {\n      result.contactCc.push(email);\n    }\n  }\n}\n\nreturn { json: result };"
      },
