      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// Get the current description and framework value\nlet description = $input.item.json.properties.description || '';\nlet frameworkValue = $input.item.json.properties.framework || '';\n\n// Remove any existing \"Framework: ...\" or \"Frameworks: ...\" line (at beginning or end)\ndescription = description.replace(/^Frameworks?:.*\\n?/m, '');\ndescription = description.replace(/\\nFrameworks?:.*$/m, '');\n\n// Parse frameworks (semicolon-separated)\nlet frameworks = frameworkValue.split(';').map(f => f.trim()).filter(f => f);\n\n// Format frameworks based on count\nlet frameworkText = '';\nif (frameworks.length === 0) {\n  frameworkText = '';\n} else if (frameworks.length === 1) {\n  frameworkText = `Framework: ${frameworks[0]}\\n`;\n} else if (frameworks.length === 2) {\n  frameworkText = `Frameworks: ${frameworks[0]} and ${frameworks[1]}\\n`;\n} else {\n  // 3 or more: \"A, B, C and D\"\n  let lastFramework = frameworks.pop();\n  frameworkText = `Frameworks: ${frameworks.join(', ')} and ${lastFramework}\\n`;\n}\n\n// Return framework line at the top + cleaned description\nreturn {\n  json: {\n    ...$input.item.json,\n    properties: {\n      ...$input.item.json.properties,\n      description: frameworkText + description\n    }\n  }\n};"
        },
